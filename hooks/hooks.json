{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/py.sh", "-m", "pit.hooks", "session-start"], "timeout": 10}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/py.sh", "-m", "pit.hooks", "stop"], "timeout": 20}]}
    ],
    "PostToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/py.sh", "-m", "pit.hooks", "post-tool-use"], "timeout": 10}]}
    ]
  }
}
