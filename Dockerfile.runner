# Optional: the Pit runner in a container, for Linux boxes where containers are the norm. The runner is a native
# process first (q runner under launchd or systemd; docs/runner.md); use this only where the work needs nothing from
# the host that a container cannot reach.
#   docker build -f Dockerfile.runner -t pit-runner .
#   docker run -d --restart=always -p 8791:8791 -e PIT_RUNNER_TOKEN=... -v pit-runner:/work pit-runner
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
# Add docker.io to the install line if your scripts drive containers through a mounted Docker socket.
COPY pit /opt/pit/pit
ENV PYTHONPATH=/opt/pit
WORKDIR /work
EXPOSE 8791
CMD ["python", "-m", "pit.runner_service", "--host", "0.0.0.0", "--port", "8791", "--workdir", "/work"]
